@page
@model ArcaneVault.Web.Pages.CollectionItems.EditModel
@{
    ViewData["Title"] = "Edit Item";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-page="./Index">My Collection</a></li>
        <li class="breadcrumb-item active" aria-current="page">Edit</li>
    </ol>
</nav>

<h1 class="h3 mb-3">Edit collection item</h1>

<div class="row">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-body">
                <form method="post">
                    <input type="hidden" asp-for="ItemId" />

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger d-none-if-empty"></div>

                    <div class="mb-3">
                        <label asp-for="Input.ItemName" class="form-label"></label>
                        <input asp-for="Input.ItemName" class="form-control" />
                        <span asp-validation-for="Input.ItemName" class="text-danger small"></span>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-sm-6">
                            <label asp-for="Input.StartingQuantity" class="form-label"></label>
                            <input asp-for="Input.StartingQuantity" type="number" min="0" class="form-control" />
                            <div class="form-text">How many you originally acquired.</div>
                            <span asp-validation-for="Input.StartingQuantity" class="text-danger small"></span>
                        </div>
                        <div class="col-sm-6">
                            <label asp-for="Input.CurrentQuantity" class="form-label"></label>
                            <input asp-for="Input.CurrentQuantity" type="number" min="0" class="form-control" />
                            <div class="form-text">
                                Lower this when you trade or sell one &mdash; the difference is what
                                feeds the platform's demand analytics.
                            </div>
                            <span asp-validation-for="Input.CurrentQuantity" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label">@Html.DisplayNameFor(m => m.Input.CategoryCodes)</label>
                        @if (Model.CategoryOptions.Count == 0)
                        {
                            <p class="text-muted small mb-0">No categories are available yet.</p>
                        }
                        else
                        {
                            <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 g-2">
                                @foreach (var option in Model.CategoryOptions)
                                {
                                    <div class="col">
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox"
                                                   name="Input.CategoryCodes" value="@option.Value"
                                                   id="cat-@option.Value"
                                                   checked="@(Model.Input.CategoryCodes.Contains(option.Value))" />
                                            <label class="form-check-label small" for="cat-@option.Value">
                                                @option.Text
                                            </label>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check-lg me-1"></i>Save changes
                        </button>
                        <a asp-page="./Index" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
