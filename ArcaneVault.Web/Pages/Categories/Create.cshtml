@page
@model ArcaneVault.Web.Pages.Categories.CreateModel
@{
    ViewData["Title"] = "New Category";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-page="./Index">Categories</a></li>
        <li class="breadcrumb-item active" aria-current="page">New</li>
    </ol>
</nav>

<h1 class="h3 mb-3">New Category</h1>

<div class="row">
    <div class="col-lg-7">
        <div class="card">
            <div class="card-body">
                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger d-none-if-empty"></div>

                    <div class="mb-3">
                        <label asp-for="Input.CategoryCode" class="form-label"></label>
                        <input asp-for="Input.CategoryCode" class="form-control font-monospace text-uppercase"
                               placeholder="e.g. TCG" maxlength="10" />
                        <div class="form-text">
                            A short unique code, letters and numbers only. This becomes the category's
                            primary key and cannot be changed later.
                        </div>
                        <span asp-validation-for="Input.CategoryCode" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Input.CategoryName" class="form-label"></label>
                        <input asp-for="Input.CategoryName" class="form-control" placeholder="e.g. Trading Card Games" />
                        <span asp-validation-for="Input.CategoryName" class="text-danger small"></span>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check-lg me-1"></i>Create
                        </button>
                        <a asp-page="./Index" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
