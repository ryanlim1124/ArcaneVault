@page
@model ArcaneVault.Web.Pages.Categories.DeleteModel
@{
    ViewData["Title"] = "Delete Category";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-page="./Index">Categories</a></li>
        <li class="breadcrumb-item active" aria-current="page">Delete</li>
    </ol>
</nav>

<h1 class="h3 mb-3">Delete Category</h1>

@if (Model.Category is not null)
{
    <div class="row">
        <div class="col-lg-7">
            <div class="card border-danger">
                <div class="card-header bg-danger-subtle">
                    <i class="bi bi-exclamation-triangle-fill me-1"></i>
                    Are you sure you want to delete this category?
                </div>
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-4">Category code</dt>
                        <dd class="col-sm-8">
                            <span class="badge text-bg-secondary font-monospace">@Model.Category.CategoryCode</span>
                        </dd>

                        <dt class="col-sm-4">Category name</dt>
                        <dd class="col-sm-8">@Model.Category.CategoryName</dd>

                        <dt class="col-sm-4">Items using it</dt>
                        <dd class="col-sm-8">@Model.Category.ItemCount</dd>
                    </dl>

                    @if (Model.Category.ItemCount > 0)
                    {
                        <div class="alert alert-warning mt-3 mb-0">
                            <i class="bi bi-info-circle me-1"></i>
                            <strong>@Model.Category.ItemCount collection item(s)</strong> still use this
                            category. The deletion will be rejected until those items are reassigned &mdash;
                            this protects collectors from losing how their items are classified.
                        </div>
                    }
                </div>
                <div class="card-footer">
                    <form method="post">
                        <input type="hidden" asp-for="Code" />
                        <button type="submit" class="btn btn-danger">
                            <i class="bi bi-trash me-1"></i>Yes, delete it
                        </button>
                        <a asp-page="./Index" class="btn btn-outline-secondary ms-2">Cancel</a>
                    </form>
                </div>
            </div>
        </div>
    </div>
}
