@page
@model ArcaneVault.Web.Pages.Categories.IndexModel
@{
    ViewData["Title"] = "Categories";
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <div>
        <h1 class="h3 mb-0"><i class="bi bi-tags me-2"></i>Category Management</h1>
        <p class="text-muted small mb-0">Master data used to classify every collection on the platform.</p>
    </div>
    <a asp-page="./Create" class="btn btn-primary">
        <i class="bi bi-plus-lg me-1"></i>New Category
    </a>
</div>

@if (Model.ErrorMessage is not null)
{
    <div class="alert alert-danger">
        <i class="bi bi-exclamation-triangle-fill me-1"></i>@Model.ErrorMessage
    </div>
}
else if (Model.Categories.Count == 0)
{
    <div class="text-center text-muted py-5">
        <i class="bi bi-inbox display-4 d-block mb-2"></i>
        No categories yet. Create the first one to get started.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Code</th>
                    <th>Name</th>
                    <th class="text-end">Items using it</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var category in Model.Categories)
                {
                    <tr>
                        <td><span class="badge text-bg-secondary font-monospace">@category.CategoryCode</span></td>
                        <td>@category.CategoryName</td>
                        <td class="text-end">
                            @if (category.ItemCount == 0)
                            {
                                <span class="text-muted">&mdash;</span>
                            }
                            else
                            {
                                <span class="badge text-bg-light">@category.ItemCount</span>
                            }
                        </td>
                        <td class="text-end text-nowrap">
                            <a asp-page="./Details" asp-route-code="@category.CategoryCode"
                               class="btn btn-sm btn-outline-secondary" title="Details">
                                <i class="bi bi-eye"></i>
                            </a>
                            <a asp-page="./Edit" asp-route-code="@category.CategoryCode"
                               class="btn btn-sm btn-outline-primary" title="Edit">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <a asp-page="./Delete" asp-route-code="@category.CategoryCode"
                               class="btn btn-sm btn-outline-danger" title="Delete">
                                <i class="bi bi-trash"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
