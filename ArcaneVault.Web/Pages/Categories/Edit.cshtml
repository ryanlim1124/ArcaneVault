@page
@model ArcaneVault.Web.Pages.Categories.EditModel
@{
    ViewData["Title"] = "Edit Category";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-page="./Index">Categories</a></li>
        <li class="breadcrumb-item active" aria-current="page">Edit</li>
    </ol>
</nav>

<h1 class="h3 mb-3">Edit Category</h1>

<div class="row">
    <div class="col-lg-7">
        <div class="card">
            <div class="card-body">
                <form method="post">
                    <input type="hidden" asp-for="Code" />

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger d-none-if-empty"></div>

                    <div class="mb-3">
                        <label class="form-label">Category code</label>
                        @* Read-only: the code is the primary key and is referenced by the
                           CollectionItemCategories join table, so it is fixed once created. *@
                        <input class="form-control font-monospace" value="@Model.Code" disabled />
                        <div class="form-text">The category code cannot be changed after creation.</div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Input.CategoryName" class="form-label"></label>
                        <input asp-for="Input.CategoryName" class="form-control" />
                        <span asp-validation-for="Input.CategoryName" class="text-danger small"></span>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check-lg me-1"></i>Save changes
                        </button>
                        <a asp-page="./Index" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
